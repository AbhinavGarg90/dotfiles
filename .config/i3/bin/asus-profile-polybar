#!/bin/sh

OUT=$(asusctl profile -p 2>/dev/null)

ACTIVE=$(echo "$OUT" | sed -n 's/^Active profile is //p' | tr '[:upper:]' '[:lower:]')
AC=$(echo "$OUT" | sed -n 's/^Profile on AC is //p' | tr '[:upper:]' '[:lower:]')
BAT=$(echo "$OUT" | sed -n 's/^Profile on Battery is //p' | tr '[:upper:]' '[:lower:]')

case "$ACTIVE" in
  quiet)
    echo "󰌪 Quiet"
    ;;
  balanced)
    echo "󰗑 Balanced"
    ;;
  performance)
    echo "󰑣 Perf"
    ;;
  *)
    echo "󰍛 N/A"
    ;;
esac

